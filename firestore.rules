rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ── USER DATA ──
    // Each user can only read/write their OWN document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollections (workouts, foodLog, chatHistory, finances, …) — same rule
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── SOCIAL / PUBLIC PROFILES ──
    // Any signed-in user can open a profile by id. Listing is limited to the two
    // queries the Social page runs: profiles that list you in `friends` or in
    // `outgoingRequests` (array-contains your uid), capped at 200 results.
    // Only the owner can write, and only the fields/shapes the app uses.
    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 200 && request.auth.uid in resource.data.friends;
      allow list: if signedIn() && request.query.limit <= 200 && request.auth.uid in resource.data.outgoingRequests;
      allow create, update: if isOwner(userId) && validPublicProfile(userId);
      allow delete: if isOwner(userId);
    }

    function optString(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optNumber(d, k, max) { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] <= max); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function listSize(data, k) { return data != null && k in data && data[k] is list ? data[k].size() : 0; }

    function validPublicProfile(userId) {
      let d = request.resource.data;
      let before = resource == null ? null : resource.data;
      return d.keys().hasOnly([
          'uid', 'name', 'totalXP', 'streak', 'workouts', 'level', 'rank', 'recentWorkouts',
          'updatedAt', 'levelUpDate', 'migratedLegacy', 'friends', 'outgoingRequests',
          'declinedRequests', 'posts', 'likes', 'groupChallenges',
          'emailHash' // legacy; the app deletes it
        ])
        && (!('uid' in d) || d.uid == userId)
        && optString(d, 'name', 60)
        && optNumber(d, 'totalXP', 1000000000)
        && optNumber(d, 'streak', 100000)
        && optNumber(d, 'workouts', 100000)
        && optNumber(d, 'level', 100000)
        && optString(d, 'rank', 40)
        && optString(d, 'updatedAt', 40)
        && optString(d, 'levelUpDate', 10)
        && optString(d, 'emailHash', 64)
        && (!('migratedLegacy' in d) || d.migratedLegacy is bool)
        && optList(d, 'recentWorkouts', 14)
        && optList(d, 'posts', 20)
        && optList(d, 'groupChallenges', 5)
        && optList(d, 'friends', 500)
        && optList(d, 'outgoingRequests', 50)
        && optList(d, 'declinedRequests', 1000)
        && optList(d, 'likes', 2000)
        // Friend requests: at most one new request per write, never to yourself
        && listSize(d, 'outgoingRequests') <= listSize(before, 'outgoingRequests') + 1
        && !(userId in d.get('outgoingRequests', []))
        && !(userId in d.get('friends', []));
    }

    // ── EMAIL LOOKUP ── emailIndex/{sha256(lower-cased email)} → { uid }
    // Only fetchable by exact hash (no listing), and an account can only write the
    // entry for its own sign-in email, pointing at itself.
    match /emailIndex/{hash} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email is string
        && hash == hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── DENY EVERYTHING ELSE ──
    // Any collection not explicitly listed above is blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
